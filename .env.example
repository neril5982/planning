# Base de données
DB_HOST=db
DB_PORT=3306
DB_NAME=planning
DB_USER=planning
DB_PASS=change_me
MYSQL_ROOT_PASSWORD=change_me

# JWT — générer avec : php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change_me_minimum_32_caracteres
JWT_TTL=86400

# SMTP (reset password, activation compte) — laisser vide pour fallback mail()
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@votredomaine.com
SMTP_FROM_NAME=Planning

# Application
APP_URL=http://localhost:8080
TZ=Europe/Paris

# Cloudflare Turnstile (anti brute-force login) — laisser vide pour désactiver
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
